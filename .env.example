# Application port
APP_PORT=8000

# PostgreSQL credentials
POSTGRES_DB=schooltest
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change_this_password_in_production

# Application Database URL (must match credentials above)
DATABASE_URL=postgresql://appuser:change_this_password_in_production@postgres:5432/schooltest

# Security (Change in production!)
SECRET_KEY=change-this-secret-key-in-production-please
DEBUG=False

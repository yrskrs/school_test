# Application port
APP_PORT=8080

# PostgreSQL credentials
POSTGRES_DB=schooltest
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change_this_password_in_production

# Application Database URL (must match credentials above)
DATABASE_URL=postgresql://appuser:change_this_password_in_production@postgres:5432/schooltest

# Security (Change in production!)
SECRET_KEY=change-this-secret-key-in-production-please
DEBUG=False

# Optional server-to-server roster integration. Generate separate long tokens.
# Browser URLs and internal API URLs differ; never put these tokens in frontend JS.
INTEGRATION_NETWORK=school-integration
ROSTER_SYNC_TOKEN=
ROSTER_PEERS=[]
ROSTER_SYNC_INTERVAL=30
# ROSTER_PEERS is a JSON array: [{"url":"http://peer-alias:8000/api/v2/roster-sync/","token":"peer-server-token"}]

# Timezone of historical naive result timestamps. Existing Docker images use UTC.
LEGACY_RESULT_TIMEZONE=UTC

# Optional public browser origin used in the journal connection code.
PUBLIC_BASE_URL=
# Optional server address embedded in the private connection code.
# Same Docker host: http://schooltest-api:8000 or http://schoolwork-api:8000.
JOURNAL_API_BASE_URL=
